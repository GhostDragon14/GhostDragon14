# Required - PostgreSQL connection string
DATABASE_URL=

# Required - JWT signing secret (64+ random chars)
JWT_SECRET=
JWT_EXPIRES_IN=7d

# App
PORT=5000
NODE_ENV=production
FRONTEND_URL=https://nutrilog.vercel.app

# Email (Gmail SMTP)
# 1. Enable 2FA on your Gmail account
# 2. Go to Account > Security > App Passwords > Create for 'Mail'
# 3. Use the 16-char app password below
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your-gmail@gmail.com
SMTP_PASS=xxxx-xxxx-xxxx-xxxx
FROM_EMAIL=NutriLog <noreply@nutrilog.com>

# Stripe - https://dashboard.stripe.com/
STRIPE_SECRET_KEY=sk_live_...
STRIPE_WEBHOOK_SECRET=whsec_...
STRIPE_PREMIUM_PRICE_ID=price_...
STRIPE_PREMIUM_PLUS_PRICE_ID=price_...

# Nutritionix - https://developer.nutritionix.com/
NUTRITIONIX_APP_ID=
NUTRITIONIX_API_KEY=

# USDA FoodData Central - https://fdc.nal.usda.gov/api-guide.html
# Use DEMO_KEY for development, get a free key for production
USDA_API_KEY=DEMO_KEY

# Cloudinary - https://cloudinary.com/
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Strava OAuth (optional) - https://www.strava.com/settings/api
STRAVA_CLIENT_ID=
STRAVA_CLIENT_SECRET=

# Google OAuth (optional) - https://console.cloud.google.com/
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
