# Database
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/nutrilog

# JWT
JWT_SECRET=replace-with-64-char-random-string
JWT_EXPIRES_IN=7d

# App
PORT=5000
NODE_ENV=production
FRONTEND_URL=https://nutrilog.vercel.app

# Email (Gmail SMTP)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your-gmail@gmail.com
SMTP_PASS=your-gmail-app-password
FROM_EMAIL=NutriLog <noreply@nutrilog.com>

# Stripe
STRIPE_SECRET_KEY=sk_live_...
STRIPE_WEBHOOK_SECRET=whsec_...
STRIPE_PREMIUM_PRICE_ID=price_premium_monthly
STRIPE_PREMIUM_PLUS_PRICE_ID=price_premium_plus_monthly

# Nutritionix (https://developer.nutritionix.com)
NUTRITIONIX_APP_ID=your-app-id
NUTRITIONIX_API_KEY=your-api-key

# USDA FoodData Central (https://fdc.nal.usda.gov/api-guide.html)
USDA_API_KEY=DEMO_KEY

# Cloudinary (https://cloudinary.com)
CLOUDINARY_CLOUD_NAME=your-cloud-name
CLOUDINARY_API_KEY=your-api-key
CLOUDINARY_API_SECRET=your-api-secret

# Strava OAuth (https://www.strava.com/settings/api)
STRAVA_CLIENT_ID=your-client-id
STRAVA_CLIENT_SECRET=your-client-secret

# Google Fit OAuth
GOOGLE_CLIENT_ID=your-client-id
GOOGLE_CLIENT_SECRET=your-client-secret
