generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  USER
  ADMIN
}

enum SubscriptionTier {
  FREE
  PREMIUM
  PREMIUM_PLUS
}

enum MealType {
  BREAKFAST
  LUNCH
  DINNER
  SNACK
}

enum WorkoutCategory {
  STRENGTH
  CARDIO
  FLEXIBILITY
  SPORTS
  HIIT
  YOGA
  SWIMMING
  CYCLING
  RUNNING
  OTHER
}

enum FitnessGoal {
  WEIGHT_LOSS
  MUSCLE_GAIN
  MAINTENANCE
  ENDURANCE
  FLEXIBILITY
  GENERAL_FITNESS
}

enum GroupRole {
  ADMIN
  MEMBER
}

enum ChallengeType {
  STEPS
  CALORIES_BURNED
  WORKOUTS
  WATER_INTAKE
  WEIGHT_LOSS
}

model User {
  id               String           @id @default(uuid())
  email            String           @unique
  password         String
  name             String
  avatar           String?
  emailVerified    Boolean          @default(false)
  verifyToken      String?          @unique
  verifyTokenExp   DateTime?
  resetToken       String?          @unique
  resetTokenExp    DateTime?
  subscription     SubscriptionTier @default(FREE)
  stripeCustomerId String?          @unique
  stripeSubId      String?          @unique
  subscriptionEnd  DateTime?
  language         String           @default("en")
  theme            String           @default("light")
  heightCm         Float?
  weightUnit       String           @default("kg")
  heightUnit       String           @default("cm")
  role             Role             @default(USER)
  timezone         String           @default("UTC")
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt

  foodLogs              FoodLog[]
  waterLogs             WaterLog[]
  stepLogs              StepLog[]
  weightLogs            WeightLog[]
  recipes               Recipe[]
  workouts              Workout[]
  workoutSchedules      WorkoutSchedule[]
  photos                Photo[]
  goals                 NutritionGoal?
  groupMemberships      GroupMember[]
  challengeParticipants ChallengeParticipant[]
  sentInvites           GroupInvite[]          @relation("SentInvites")
  healthRecommendations HealthRecommendation[]

  @@index([email])
}

model NutritionGoal {
  id           String   @id @default(uuid())
  userId       String   @unique
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  calories     Int      @default(2000)
  protein      Int      @default(150)
  carbs        Int      @default(250)
  fat          Int      @default(65)
  fiber        Int      @default(25)
  sodium       Int      @default(2300)
  waterMl      Int      @default(2000)
  steps        Int      @default(10000)
  weightTarget Float?
  activityLevel String  @default("moderate")
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model FoodLog {
  id          String   @id @default(uuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  foodName    String
  brandName   String?
  calories    Float
  protein     Float    @default(0)
  carbs       Float    @default(0)
  fat         Float    @default(0)
  fiber       Float    @default(0)
  sugar       Float    @default(0)
  sodium      Float    @default(0)
  saturatedFat Float   @default(0)
  cholesterol Float    @default(0)
  serving     Float
  servingUnit String
  mealType    MealType
  date        DateTime
  barcode     String?
  source      String   @default("manual")
  externalId  String?
  createdAt   DateTime @default(now())

  @@index([userId, date])
}

model WaterLog {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  amountMl  Float
  date      DateTime
  createdAt DateTime @default(now())

  @@index([userId, date])
}

model StepLog {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  steps     Int
  date      DateTime
  source    String   @default("manual")
  createdAt DateTime @default(now())

  @@index([userId, date])
}

model WeightLog {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  weight    Float
  unit      String   @default("kg")
  date      DateTime
  note      String?
  createdAt DateTime @default(now())

  @@index([userId, date])
}

model Recipe {
  id           String             @id @default(uuid())
  userId       String
  user         User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  name         String
  description  String?
  servings     Int                @default(1)
  prepTime     Int?               // minutes
  cookTime     Int?               // minutes
  calories     Float
  protein      Float              @default(0)
  carbs        Float              @default(0)
  fat          Float              @default(0)
  fiber        Float              @default(0)
  instructions String?
  isPublic     Boolean            @default(false)
  imageUrl     String?
  tags         String[]
  ingredients  RecipeIngredient[]
  createdAt    DateTime           @default(now())
  updatedAt    DateTime           @updatedAt

  @@index([userId])
}

model RecipeIngredient {
  id        String  @id @default(uuid())
  recipeId  String
  recipe    Recipe  @relation(fields: [recipeId], references: [id], onDelete: Cascade)
  name      String
  amount    Float
  unit      String
  calories  Float
  protein   Float   @default(0)
  carbs     Float   @default(0)
  fat       Float   @default(0)
}

model Workout {
  id         String          @id @default(uuid())
  userId     String
  user       User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  name       String
  category   WorkoutCategory
  duration   Int             // minutes
  calories   Float           @default(0)
  notes      String?
  date       DateTime
  completed  Boolean         @default(true)
  source     String          @default("manual")
  exercises  Exercise[]
  createdAt  DateTime        @default(now())

  @@index([userId, date])
}

model Exercise {
  id         String  @id @default(uuid())
  workoutId  String
  workout    Workout @relation(fields: [workoutId], references: [id], onDelete: Cascade)
  name       String
  sets       Int?
  reps       Int?
  weightKg   Float?
  durationSec Int?
  distanceKm  Float?
  restSec     Int?
  notes       String?
}

model WorkoutSchedule {
  id         String          @id @default(uuid())
  userId     String
  user       User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  name       String
  category   WorkoutCategory
  dayOfWeek  Int             // 0=Sunday, 6=Saturday
  time       String?         // HH:MM format
  notes      String?
  completed  Boolean         @default(false)
  weekStart  DateTime
  createdAt  DateTime        @default(now())

  @@index([userId, weekStart])
}

model Photo {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  url       String
  publicId  String
  date      DateTime
  note      String?
  weight    Float?
  createdAt DateTime @default(now())

  @@index([userId, date])
}

model Group {
  id          String        @id @default(uuid())
  name        String
  description String?
  goal        FitnessGoal
  isPublic    Boolean       @default(true)
  inviteCode  String        @unique @default(uuid())
  createdBy   String
  bannerUrl   String?
  members     GroupMember[]
  challenges  Challenge[]
  invites     GroupInvite[]
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  @@index([isPublic])
}

model GroupMember {
  id       String    @id @default(uuid())
  groupId  String
  group    Group     @relation(fields: [groupId], references: [id], onDelete: Cascade)
  userId   String
  user     User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  role     GroupRole @default(MEMBER)
  joinedAt DateTime  @default(now())

  @@unique([groupId, userId])
}

model GroupInvite {
  id        String   @id @default(uuid())
  groupId   String
  group     Group    @relation(fields: [groupId], references: [id], onDelete: Cascade)
  sentBy    String
  sender    User     @relation("SentInvites", fields: [sentBy], references: [id])
  email     String
  token     String   @unique @default(uuid())
  accepted  Boolean  @default(false)
  expiresAt DateTime
  createdAt DateTime @default(now())
}

model Challenge {
  id           String                 @id @default(uuid())
  groupId      String
  group        Group                  @relation(fields: [groupId], references: [id], onDelete: Cascade)
  name         String
  description  String?
  type         ChallengeType
  goal         Float
  startDate    DateTime
  endDate      DateTime
  participants ChallengeParticipant[]
  createdAt    DateTime               @default(now())
}

model ChallengeParticipant {
  id          String    @id @default(uuid())
  challengeId String
  challenge   Challenge @relation(fields: [challengeId], references: [id], onDelete: Cascade)
  userId      String
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  progress    Float     @default(0)
  joinedAt    DateTime  @default(now())

  @@unique([challengeId, userId])
}

model Disease {
  id           String   @id @default(uuid())
  name         String
  description  String
  symptoms     String[]
  dietaryRecs  String[]
  exerciseRecs String[]
  avoidFoods   String[]
  goodFoods    String[]
  category     String
  icdCode      String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model HealthRecommendation {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  diseaseId String
  disease   Disease  @relation(fields: [diseaseId], references: [id])
  notes     String?
  createdAt DateTime @default(now())
}

model HealthRecommendation {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  type      String
  message   String
  data      Json?
  read      Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([userId])
}
